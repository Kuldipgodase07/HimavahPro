# Copy to .env. No real secrets belong in source control.
# HIMAVAH_SECRET=            # token-signing key; auto-generated into data/.secret when unset
# DATABASE_URL=              # e.g. postgresql+psycopg://user:pass@host/db (default: SQLite)
HIMAVAH_DEMO_AUTH=true       # demo sign-in only; replace the IdentityProvider for real deployments
# HIMAVAH_DEMO_PASSWORD=demo-password
# HIMAVAH_DEMO_MFA_CODE=123456
